{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "analytics",
          "format": "url",
          "env": "ANALYTICS_URL"
        }
      ]
    },
    "analytics": {
      "root": "services/analytics/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 21 * * 1-5"
    }
  ]
}

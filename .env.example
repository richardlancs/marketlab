# Copy to .env.local for development, and set the same names in your host's
# environment settings for production. Never commit real values.

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL, e.g. http://localhost:3000 or https://your-app.example.com
BETTER_AUTH_URL=
# Online only: the hosts sign-in may be used from, comma-separated, e.g.
# marketlab.example.com,marketlab-*-yourteam.vercel.app (the second covers this
# project's Vercel preview URLs). Never *.vercel.app: that trusts every Vercel site.
# BETTER_AUTH_ALLOWED_HOSTS=

# Optional in development (defaults to file:local.db).
# Production: a Turso database URL (libsql://…) and its auth token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Only when self-hosting on several server instances (not needed on Vercel):
# the same random value on every instance, so Server Actions work on all of them.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Real end-of-day prices from Tiingo (free account: https://www.tiingo.com).
# Without a key the app uses its mock market. The free plan is for PERSONAL use
# only: never set this on a public deployment. On Vercel the key is ignored
# unless MARKET_DATA_PRIVATE=1 (only for a deployment nobody else can open).
TIINGO_API_KEY=
# Set to "mock" to use the mock market even when a key is set.
# MARKET_DATA_SOURCE=mock
# MARKET_DATA_PRIVATE=1

# Optional: real SEC filings on stock pages (public records, fine on a public
# site). The SEC requires every request to name who's asking: a name and a
# contact email, e.g. "MarketLab you@example.com". Without it, filings are hidden.
# SEC_USER_AGENT=

# Online only: lets Vercel Cron run the daily job (/api/cron/daily). Vercel
# sends it as a bearer token; without it, every request to the job is refused.
# Generate one with: openssl rand -base64 32
# CRON_SECRET=

# Optional: sending email (verification links) through Resend (https://resend.com).
# EMAIL_FROM must be an address on a domain verified with Resend, e.g.
# "MarketLab <hello@your-domain.com>". Without these, verification is off in
# production, and in development emails are printed to the server console.
# RESEND_API_KEY=
# EMAIL_FROM=

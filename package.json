{
  "name": "marketlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && MARKET_DATA_SOURCE=mock npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "logos:fetch": "node scripts/fetch-logos.mjs",
    "analytics:install": "cd services/analytics && uv sync --extra dev --locked",
    "analytics:dev": "cd services/analytics && uv run --extra dev --env-file ../../.env.local uvicorn main:app --host 127.0.0.1 --port 8000",
    "test:python": "cd services/analytics && uv run --extra dev pytest -q",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
